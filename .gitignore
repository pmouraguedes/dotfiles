# ssh: only config, known_hosts and public keys are versioned
ssh-boku/.ssh/*
!ssh-boku/.ssh/config
!ssh-boku/.ssh/known_hosts
!ssh-boku/.ssh/*.pub
ssh-boku/testlab.pem

# backups
*.bak
*.bak-*
*.bak.*
*.old

# global ignore has **/.claude; version this one
!/claude/.claude
!/claude/.claude/CLAUDE.md
